# ==============================================================================
# MARIADB TUNING FOR 4GB RAM VPS (PEMILOS HIGH-CONCURRENCY)
# ==============================================================================
# Salin ke: /etc/mysql/mariadb.conf.d/99-pemilos.cnf
# Terapkan dengan: sudo systemctl restart mariadb

[mysqld]
# 1. Alokasi Memori InnoDB (1GB dari 4GB RAM, menampung seluruh data Pemilos di RAM)
innodb_buffer_pool_size         = 1G
innodb_buffer_pool_instances     = 1
innodb_log_file_size            = 128M
innodb_log_buffer_size          = 16M

# 2. THROUGHPUT WRITE PENCOBLOSAN (KUNCI PERFORMA SUB-10MS)
# Nilai 2: Tulis ke buffer memori saat commit, flush ke disk setiap 1 detik.
# Menghindari disk I/O bottleneck saat puluhan siswa memilih serentak!
innodb_flush_log_at_trx_commit  = 2
innodb_flush_method             = O_DIRECT

# 3. KONEKSI & TIMEOUT
max_connections                 = 100
wait_timeout                    = 60
interactive_timeout             = 60
connect_timeout                 = 10
max_connect_errors              = 1000

# 4. BUFFER PER CONNECTION
sort_buffer_size                = 2M
read_buffer_size                = 1M
read_rnd_buffer_size            = 1M
join_buffer_size                = 2M
tmp_table_size                  = 32M
max_heap_table_size             = 32M
